version: 1
scenario: rolling

# ===========================================================================
# 运动 #1 匀速（滚动/平动）
#
# Zero new code: this reuses the mentor's `rolling` scenario unchanged.  What
# differs from his config is only the ASSET SET and the MAP -- ours, per the
# project rule that we use our own ReplicaCAD scene and our own GSO objects.
#
# Physics note: the scenario integrates a near-uniform pure-rolling state from
# the sampled initial conditions; rolling/spinning drag are 0 and there is no
# external force.  The solver still resolves gravity, contact and friction --
# nothing is prescribed frame by frame.
# ===========================================================================

controlled_variants:
  variable: initial_speed
  multipliers: [1.0, 0.5, 1.5]
  labels: [x1, x0.5, x1.5]

selection:
  map_ids: [replicad_apartment]
  asset_ids:
    - gso_whey_protein_vanilla
    - gso_room_essentials_fabric_cube_lavender

timing:
  # 81 frames at 16 fps = 5.0625 s.  physics_fps must be divisible by video_fps.
  duration_seconds: 5.0625
  frame_count: 81
  # 560 = 16 fps x 35 substeps.  Chosen by measurement, not by taste: Bullet's
  # contact solver injects energy into rolling contact at coarse steps while the
  # hull's faceting removes it, and 560 Hz is where those cancel.  Measured mean
  # |net speed drift| over seeds 1001-1003: 6.8% at 560 Hz vs 9.2% at 480,
  # 13.4% at 640 and 21.2% at 880 (tools/_t1b_profile.sh).
  #
  # This matters because the vendored Kubric wrapper never calls setTimeStep
  # (its own source says "TODO: setTimeStep if scene.step_rate != 240 Hz"), so
  # before that was fixed a finer step_rate silently stretched simulated time
  # instead of shortening the step.  At the calibrated 240 Hz nothing changes.
  physics_fps: 560
  video_fps: 16

physics:
  gravity: [0.0, 0.0, -9.81]
  rolling_friction: 0.0
  spinning_friction: 0.0
  # Frictionless support for the assets that SLIDE.  The convex-hull actors that
  # stay upright brake at mu*g = 3.5 m/s^2 and stop inside one frame on the
  # scanned floor, so their uniform motion is the frictionless idealisation
  # (measured: mu 0.01 -> stops in 0.36 m, rel_change 0.999; mu 0 -> travels
  # 1.000 m at constant speed, rel_change 0.0000).
  #
  # The ROLLING asset must NOT be frictionless -- friction is the torque that
  # makes it roll -- so it gets its own range from the `orientation` block below,
  # which applies only to the assets listed there.  Changing this shared value
  # instead would brake every other asset in `selection`.
  friction_range: [0.0, 0.0]
  restitution_range: [0.05, 0.20]
  # Travel expressed in object extents so it stays visible for both a 0.12 m
  # can and a 0.28 m fabric cube.
  travel_object_extent_range: [4.0, 7.0]
  direction_degrees_range: [-10.0, 10.0]
  angular_velocity_policy: pure_rolling
  external_force: [0.0, 0.0, 0.0]

# ---------------------------------------------------------------------------
# Initial pose (additive capability; see physim.scenarios.common).
#
# The user's objection was physical: an upright container sliding across a floor
# at constant velocity has no motivation.  Laid on its SIDE the same container
# ROLLS, and a rolling body at constant velocity is exactly Newton's first law,
# so the motion becomes motivated instead of arbitrary.
#
# `asset_ids` restricts the pose to the one near-circular asset we own.  Every
# other asset in `selection` (the fabric cube) keeps the manifest's authored
# upright pose, and any scenario config without this block is unaffected.
# ---------------------------------------------------------------------------
orientation:
  policy: side
  asset_ids:
    - gso_whey_protein_vanilla
  # Use the asset's refined side hull rather than its 64-vertex upright hull.
  # Measured at an identical initial condition: the coarse hull's cross-section
  # is only a ~16-gon, so the can rocks facet-to-facet and stops (decay
  # +0.674 /s); the refined hull rolls (slip 0.996, decay -0.055 /s).
  refined_collision: true
  friction_range: [0.30, 0.60]

surface:
  allowed_types: [floor]
  min_up_dot: 0.98
  edge_margin: 0.10

validation:
  max_sample_attempts: 200
  reject_initial_overlap: true
  min_travel_distance: 0.05
  min_travel_object_extent_ratio: 1.0
  max_linear_speed: 10.0
  max_trajectory_extent_object_ratio: 20.0
  # The scene floor is real scanned geometry, so allow a slightly looser speed
  # band than a perfectly flat synthetic plane would need.
  max_speed_relative_change: 0.25
  require_supported: true
  require_in_map_bounds: true

camera:
  policy: trajectory_side
  relative_to_trajectory: true
  side: random
  azimuth_offset_degrees_range: [-25.0, 25.0]
  focal_length_mm: 40.0
  framing:
    sensor_width_mm: 36.0
    trajectory_frame_fraction: 0.80
    object_padding: 0.25
    min_object_frame_fraction: 0.03
    max_object_frame_fraction: 0.55
    min_object_frame_area_fraction: 0.0025
    max_object_frame_area_fraction: 0.20
    min_distance: 0.50
    max_distance: 8.00
    elevation_degrees: 12.0
    min_height_above_trajectory: 0.25
    look_at_offset: 0.0

output:
  resolution: [1920, 1080]
  modalities: [rgb, depth, segmentation]
  save_physics_trajectory: true
  save_render_trajectory: true
  save_collision_events: true
  save_config: true
  write_video: true
